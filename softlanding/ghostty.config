# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Ghostty — soft-landing 초심자 기본값                                  ║
# ║  위치: ~/.config/ghostty/config                                        ║
# ║  bootstrap 이 비파괴로 복사 (기존 파일 있으면 .bak 백업 후 보존)        ║
# ║  개인 설정 복사가 아니라 "처음 켰을 때 보기 좋은" 일반 기본값입니다.    ║
# ╚══════════════════════════════════════════════════════════════════════╝

theme = catppuccin-mocha
font-family = JetBrains Mono     # Ghostty 내장 폰트 (별도 설치 불필요)
font-size = 14
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.96
cursor-style = block
copy-on-select = true
macos-option-as-alt = true       # ⌥+키 가 Alt/Meta 로 동작 (개발용 필수)

# 더 바꾸려면: https://ghostty.org/docs/config 참고
# 설정 변경 후 Ghostty 에서 ⌘⇧, (reload config) 또는 재실행
